# Local development: copy to .env. On Vercel, add these under Project -> Settings -> Environment Variables.

# Postgres connection string. Vercel's Postgres (Neon) integration adds POSTGRES_URL for you.
DATABASE_URL=

# Long random string (32+ chars):  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# This email becomes the admin once it is confirmed.
ADMIN_EMAIL=

# Gmail that sends the 6-digit confirmation codes.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: use a different email service instead of Gmail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AJ's Bloom <no-reply@example.com>"
